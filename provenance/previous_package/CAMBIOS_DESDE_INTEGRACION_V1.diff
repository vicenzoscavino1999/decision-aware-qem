+            'analysis_records_equal_excluding_provenance':48,'selector_choices_equal':96,
+            'outcomes_csv_byte_identical':True,'summary_equal':True,
+            'readout_probability_vectors_checked':48*3*25,'readout_max_abs_error':max_readout_error,
